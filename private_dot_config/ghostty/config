# config-file = ?auto/theme.ghostty

theme = Catppuccin Mocha
background-opacity = 0.86
foreground = #eff1f5
background = #000000
cursor-text = #eff1f5
cursor-style = bar
cursor-style-blink = true

font-size = 11
window-width = 120
window-height = 30

app-notifications = no-clipboard-copy
bell-features = attention,no-system,no-audio,no-title,no-border
clipboard-paste-protection = true
confirm-close-surface = false
copy-on-select = clipboard
right-click-action = copy-or-paste
async-backend = epoll
link-url = true

keybind = ctrl+f8=paste_from_clipboard
keybind = f11=toggle_fullscreen

# tmux bindings
keybind = shift+arrow_left=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = shift+arrow_right=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = shift+arrow_up=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = shift+arrow_down=unbind
keybind = ctrl+alt+arrow_down=unbind
