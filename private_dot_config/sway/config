for_window [app_id="gnome-calendar"] floating enable

### startup
exec dunst
exec dex --autostart --search-paths $HOME/.config/autostart
exec lxqt-policykit-agent
exec wl-paste -t text --watch $HOME/go/bin/clipman store
exec_always swaymsg workspace $workspace1
