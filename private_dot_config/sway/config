assign [title="Musish"] $workspace10
assign [title="Apple Music"] $workspace10
assign [app_id="shortwave"] $workspace10
assign [class="JDownloader"] $workspace9
assign [class="minecraft-launcher"] $workspace8
assign [class="Steam"] $workspace8
assign [class="Discord"] $workspace5
assign [class="Signal"] $workspace5
assign [class="Slack"] $workspace5
