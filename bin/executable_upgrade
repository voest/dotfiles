#!/bin/bash

efi_backup_dir="/boot/efi-backup"
snapshot_dir="@snapshots"
snapshot_prefix="@arch-upgrade"
snapshot_max_age=7
upgrade_timestamp=$(date -Is)

function msg () {
  echo -n "$(tput bold)=> $(tput setaf 3)"
  echo "$*$(tput sgr0)"
}

# optional command
cmd=$1

# # root check
# if [[ $EUID -ne 0 ]]; then
#   echo "you're not root... duh!"
#   exit 1
# fi

# privileges check
if [[ -z $SUDO_USER ]]; then
	run0 --empower "$0"
  exit 1
fi

# get root partition uuid and create mount point
rootfs=$(findmnt -o +UUID -J / | jq '.filesystems[] .uuid')
mountpoint=$(run0 mktemp -d)

# list snapshots
if [[ "$cmd" == "ls" ]]; then
  msg Snapshots
  run0 mount UUID="${rootfs}" -o subvol=/ "${mountpoint}"
  run0 btrfs subvolume list -r "${mountpoint}" | grep "${snapshot_dir}/${snapshot_prefix}"
  run0 umount "${mountpoint}"
  run0 rmdir "${mountpoint}"
  exit
fi

# delete snapshots
if [[ "$cmd" == "rm" ]]; then
  msg Delete all snapshots
  run0 mount UUID="${rootfs}" -o subvol=/ "${mountpoint}"
  run0 btrfs subvolume list -r "${mountpoint}" | \
    grep "${snapshot_dir}/${snapshot_prefix}" | \
    rev | cut -d ' ' -f 1 | rev | \
    xargs -r -I% run0 btrfs subvolume delete -c "${mountpoint}/%" | \
    sed "s#${mountpoint}/##g"
  run0 umount "${mountpoint}"
  run0 rmdir "${mountpoint}"
  exit
fi

# unknown
if [[ -n "$cmd" ]]; then
  echo "Unknown command"
  exit 1
fi

# /efi backup
msg Create /efi backup
efi_backup="${efi_backup_dir}/efi-${upgrade_timestamp}"
run0 mkdir -p "${efi_backup}"
run0 cp -ar "/efi" "${efi_backup}" && echo "done"
run0 touch "${efi_backup}"
echo

# rootfs snapshot
msg Create snapshot
snapshot="${snapshot_dir}/${snapshot_prefix}-${upgrade_timestamp}"
if run0 mount UUID="${rootfs}" -o subvol=/ "${mountpoint}"; then
  run0 touch /
  run0 btrfs subvolume snapshot -r "${mountpoint}/@" "${mountpoint}/${snapshot}" | sed "s#${mountpoint}/##g"
  rm -r "${efi_backup}"
fi
echo

# packages w/o kernel
msg Packages w/o kernel
run0 pacman -Syu --ignore linux
echo

# aur packages
msg AUR Packages
yay --aur -Syu
echo

# flatpaks
msg Flatpaks
run0 flatpak update
echo

# zinit
msg zinit
zsh -ilsc 'zinit update'
echo

# nvim
msg nvim
nvim '+lua vim.pack.update()'
echo

# mise
msg mise
mise up
echo
 
# kernel
msg Kernel
run0 pacman -Su
echo

# cache
msg Clean cache
run0 paccache -r
echo

# autoremove
msg Clean unused dependencies
unused=$(pacman -Qdtq)
if [[ -z "${unused}" ]]; then
  echo "Nothing to do."
else
  # shellcheck disable=2086
  run0 pacman -Rs ${unused}
fi
echo

# new configs
msg New configs
run0 fd -H pacnew /etc
echo

# remove old snapshots
msg Prune old snapshots
snapshots=$(run0 btrfs subvolume list -r "${mountpoint}" | \
  grep "${snapshot_dir}/${snapshot_prefix}" | rev | \
  cut -d ' ' -f 1 | cut -d '/' -f 1 | \
  rev | \
  xargs -r -I% find "${mountpoint}/${snapshot_dir}" -mindepth 1 -maxdepth 1 -type d -name '%' -mtime +${snapshot_max_age})
if [[ -z "${snapshots}" ]]; then
  echo "No snapshots to prune"
else
  echo "$snapshots" | xargs -r -I% run0 btrfs subvolume delete -c % | \
  sed "s#${mountpoint}/##g"
fi
run0 umount "${mountpoint}"
run0 rmdir "${mountpoint}"
